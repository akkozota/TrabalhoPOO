package turismo.ui;

import turismo.negocio.*;
import java.util.List;
import java.util.Scanner;

public class Main {
    static Scanner scn = new Scanner(System.in);

    static int larguraColuna = 15; //largura de tds as colunas

    public static void main(String[] args) {
        Sistema sist = Sistema.getInstance(); //criando e chamando o singleton da classe,
        //o sist é uma referência p objeto da classe Sistema, q aponta p única instância do sistema
        // sistema, que cria um obj sist
       // sist.init(); //executando o metodo init desse objeto

        Usuario usuario = null;

        do {
            //LOGIN
            System.out.println("\n Bem-vindo ao turismo no vale !");
            System.out.println("\n --- REALIZE O LOGIN ---");
            System.out.println("\n NOME DE USUÁRIO:");
            String nomeUsuario = scn.next();

            System.out.println("\n EMAIL:");
            String email = scn.next();

            System.out.println("\n SENHA:");
            String senhaLogin = scn.next();

            usuario = sist.loginUsuario(nomeUsuario, email, senhaLogin);

            if (usuario == null) {
                System.out.println("\n --- LOGIN INVÁLIDO !! ---");
            }


        } while (usuario == null);

        while (true) {

            if (usuario.getTipoUsuario() == TipoUsuario.NORMAL) {
                menuNormal(sist, usuario);
            } else if (usuario.getTipoUsuario() == TipoUsuario.PROPRIETARIO) {
                menuProprietario(sist, usuario);
            } else if (usuario.getTipoUsuario() == TipoUsuario.ADMIN) {
               menuAdmin(sist, usuario);
            }

        }
    }

    // -- USUÁRIO NORMAL --

    static void menuNormal(Sistema sist, Usuario usuario) {
        int opcao;
        do {
            System.out.println("\n --- TURISMO NO VALE - USUÁRIO NORMAL ---");
            System.out.println("0 - SAIR");
            System.out.println("1 - BUSCAR PONTO");
            System.out.println("2 - BUSCAR EVENTO");
            System.out.println("3 - SOLICITAR PROPRIEDADE");
            System.out.println("4 - LISTAR PONTOS POR CIDADE");
            System.out.println("5 - LISTAR EVENTOS POR CIDADE");
            System.out.println("6 - LISTAR PONTOS POR CATEGORIA");
            System.out.println("7 - LISTAR PONTOS");
            System.out.println("8 - LISTAR EVENTOS");

            System.out.println("\nEscolha uma opção:");
            opcao = scn.nextInt();
            scn.nextLine();

            switch (opcao) {

                case 0: //sair
                    System.out.print("Finalizando o programa...");
                    return;
                case 1: //buscar ponto e se encontrar o detalhar.
                    scn.nextLine();
                    System.out.println(" -- Digite o nome de um ponto turístico: --");
                    String nomePonto = scn.nextLine();

                    int codigo = sist.buscarPonto(nomePonto);

                    if (codigo == -1) {
                        System.out.print("ERRO! Produto não encontrada!");
                    } else {
                        //detalhadamento do ponto
                        System.out.println("Código do ponto: " + codigo);
                    }

                    break;
                case 2: //buscar evento
                    scn.nextLine();
                    System.out.println(" -- Digite o nome de um evento: --");
                    String nomeEvento = scn.nextLine();
                    int codigoEvento = sist.buscarEvento(nomeEvento);

                    if (codigoEvento == -1) {
                        System.out.println("ERRO! Evento não encontrado !");

                    } else {
                        //detalhadamento do evento
                        System.out.println();
                    }

                    break;

                case 3: //solicitar propriedade de um ponto
                    scn.nextLine();
                    System.out.println(" -- Digite o código do ponto: --");
                    int codigoPropriedade = scn.nextInt();

                    boolean solicitou = sist.solicitarPropriedade(codigoPropriedade, usuario);

                    if (solicitou) {
                        System.out.println("Solicitação enviada com sucesso!");
                    } else {
                        System.out.println("Não foi possível solicitar a propriedade.");
                    }

                    break;
                case 4: // //listar pontos por cidade
                    listarPontosCidade(sist);
                    break;
                case 5: //listar eventos por cidade
                    listarEventosCidade(sist);
                    break;
                case 6: //listar pontos por categoria
                    listarPontosCategoria(sist);
                    break;
                case 7:
                    listarPontos(sist);
                    break;
                case 8:
                    listarEventos(sist);
                    break;
                default:
                    System.out.println("Opção inválida!");
                    break;
            }
        }  while (opcao != 0) ;
    }

    // -- PROPRIETARIO --

    static void menuProprietario(Sistema sist, Usuario usuario) {
        int opcao;
        //Proprietário herda as funções do usuário normal e é capaz de editar o SEU ponto

        do {
            System.out.println("\n --- TURISMO NO VALE- PROPRIETÁRIO ---");
            System.out.println("0 - SAIR");
            System.out.println("1 - BUSCAR PONTO");
            System.out.println("2 - ALTERAR MEU PONTO");
            System.out.println("3 - LISTAGEM PONTOS POR CIDADE");
            System.out.println("4 - LISTAGEM EVENTOS POR CIDADE");
            System.out.println("5 - LISTAGEM PONTOS POR CATEGORIA");
            System.out.println("6 - LISTAR PONTOS");
            System.out.println("7 - LISTAR EVENTOS");
            opcao = scn.nextInt();

            System.out.print("\nEscolha uma opção: ");
            opcao = scn.nextInt();
            scn.nextLine();

            switch (opcao) {
                case 0: //sair
                    System.out.print("Finalizando o programa...");
                    return;

                case 1: //buscar ponto e se encontrar o detalhar.
                    scn.nextLine();
                    System.out.println(" -- Digite o nome de um ponto turístico: --");
                    String nomePonto = scn.nextLine();

                    int codigo = sist.buscarPonto(nomePonto);

                    if (codigo == -1) {
                        System.out.print("ERRO! Ponto não encontrado!");
                    } else {
                        //detalhadamento do ponto
                        System.out.println("Código do ponto: " + codigo);
                    }

                    break;
                case 2: //alterar ponto
                    System.out.print("\nDigite o c´doigo do seu ponto:");
                    int codigoAlterar = scn.nextInt();
                    scn.nextLine();

                    alterarPonto(sist, usuario, codigoAlterar);
                    break;

                case 3: // //listar pontos por cidade
                    listarPontosCidade(sist);
                    break;
                case 4: //listar eventos por cidade
                    listarEventosCidade(sist);
                    break;
                case 5: //listar pontos por categoria
                    listarPontosCategoria(sist);
                    break;
                case 6: //listar pontos
                    listarPontos(sist);
                    break;
                case 7: //listar eventos
                    listarEventos(sist);
                    break;
                default:
                    System.out.print("\nEscolha uma opção válida!");
                    break;
            }
        } while (opcao != 0);
    }


    // --- ADMINISTRADOR ---

    static void menuAdmin(Sistema sist, Usuario usuario) { //sem public pq outras classes de diferentes pacotes n vão ter acesso
        int opcao;
        do {
            System.out.println("\n --- TURISMO NO VALE- ADMINISTRADOR ---");
            System.out.println("0 - SAIR");
            System.out.println("1 - CADASTRAR PONTO");
            System.out.println("2 - BUSCAR PONTO");
            System.out.println("3 - ALTERAR PONTO");
            System.out.println("4 - INATIVAR PONTO");
            System.out.println("5 - CADASTRAR EVENTO");
            System.out.println("6 - BUSCAR EVENTO");
            System.out.println("7 - ALTERAR EVENTO");
            System.out.println("8 - EXCLUIR EVENTO");
            System.out.println("9 - LISTAR PONTOS");
            System.out.println("10 - LISTAR EVENTOS");
            System.out.println("11 - LISTAR PONTOS POR CIDADE");
            System.out.println("12 - LISTAR EVENTOS POR CIDADE");
            System.out.println("13 - LISTAR PONTOS POR CATEGORIA");
            System.out.println("14 - LISTAR PEDIDOS DE PROPRIEDADE");
            System.out.println("15 - APROVAR SOLICITAÇÃO");
            opcao = scn.nextInt();

            switch (opcao) {
                case 0:
                    System.out.println("-- Finalizando o programa! --");
                    break;

                    // -- pontos --

                case 1: // cadastrar ponto
                    cadastrarPonto(sist, usuario);
                    break;
                case 2: //buscar ponto
                    scn.nextLine();
                    System.out.println("Digite o nome da ponto turístico:");
                    String nomePonto = scn.nextLine();
                    int codigo = sist.buscarPontoPorNome(nomePonto);

                    if (codigo == -1) {
                        System.out.println("ERRO! Ponto não encontrado!");
                    } else {
                        System.out.println("Código do ponto: " + codigo);
                    }
                    break;
                case 3: //alterar ponto
                    scn.nextLine();
                    System.out.println("-- Digite o código do ponto a ser atualizado: --");
                    int codUpdate = scn.nextInt();
                    scn.nextLine();

                    alterarPonto(sist, usuario, codUpdate);

                    break;

                case 4: //inativar ponto
                    scn.nextLine();
                    System.out.println("-- Digite o código do ponto a ser alterado: --");
                    int codInativar = scn.nextInt();
                    scn.nextLine();

                    boolean inativou = sist.inativarPonto(codInativar);

                    if (!inativou) {
                        System.out.println("ERRO! O ponto não foi inativado!");
                    } else {
                        System.out.println("Ponto inativado com sucesso!");
                    }
                    break;

                //-- eventos --
                case 5: // Cadastrar evento
                    scn.nextLine();
                    System.out.print("Nome do evento: ");
                    String nomeEvento = scn.nextLine();

                    System.out.print("Digite o nome da marca deste produto: ");
                    String nomePontoEvento = scn.nextLine();

                    // procura a marca na lista do sistema
                    PontoTuristico pontoEncontrado = sist.buscarPontoPorNome(nomePontoEvento);

                    // vê se  marca existe
                    if (pontoEncontrado == null) {
                        System.out.println("ERRO! Essa marca não está cadastrada no sistema. Cadastre a marca primeiro!");
                    } else {
                        // se a marca existe, pede os outros dados do produto
                        System.out.print("Data de início do evento: ");
                        date dataInicio = scn.nextLine();

                        System.out.print("Data de fim do evento: ");
                        date dataFim = scn.nextLine();
                        scn.nextLine();

                        Evento e = Evento.getInstance(nomeEvento, pontoEncontrado, dataInicio, dataFim);
                        //variavel p guarda o endereço de onde esse produto tá na memória, não guarda o prod la
                        boolean inseriu = sist.addEvento(e);
                        if (inseriu) {

                            System.out.println("Evento cadastrado com sucesso!");
                        } else {
                            System.out.println("Já existe um evento com esse nome.");
                        }
                    }
                    break;
                case 6: //buscar evento
                    scn.nextLine();
                    System.out.println(" -- Digite o nome do evento: --");
                    String nomeEvento = scn.nextLine();

                    int procurarCodE = sist.buscarEvento(nomeEvento); //verificando se existe esse prod msm

                    if (procurarCodE ==-1) {
                        System.out.println("ERRO! Não foi encontrado evento com esse nome!");
                    } else {
                        //se achar prod com esse nome, devolve o código dele
                        //int codigoProd = sist.buscarCodProd(nomeProd);
                        System.out.println("Evento encontrado! Código do evento: " + procurarCodE);
                    }
                    break;

                case 7: //alterar evento
                    scn.nextLine();
                    alterarEvento(sist, usuario);
                    break;
                case 8: //excluir evento
                    scn.nextLine();
                    System.out.println("-- Código do produto: --");
                    int codExclusaoP = scn.nextInt();
                    scn.nextLine();

                    boolean excluiuP = sist.excluirProd(codExclusaoP);
                    if (!excluiuP) {
                        System.out.println("ERRO! Produto não encontrado!");
                    } else {
                        System.out.println("Produto excluído com sucesso!");
                    }

                    break;
                case 9: //listagem pontos
                    scn.nextLine();
                    listarPontos(sist);
                    break;

                case 10: //listagem eventos
                    scn.nextLine();
                    listarEventos(sist);
                    break;

                case 11: //listagem pontos por cidade
                    listarPontosCidade(sist);
                    break;
                case 12: //listagem eventos por cidade
                    listarEventosCidade(sist);
                    break;
                case 13: //listagem pontos por categoria
                    listarPontosCategoria;
                    break;
                case 14: //listar solicitações de aprovação
                    listarPedidos(sist);
                    break;
                case 15: //aprovar propriedade
                    aprovarPropriedade(sist, usuario);
                    break;
                default: // se não entrar em nenhum case
                    System.out.println("Opção invalida: escolha entre 0 e 15");
                    break;
            }

        } while (opcao != 0);
    }

    static void cadastrarPonto(Sistema sist, Usuario usuario) {
        System.out.println("\n-- Cadastro de ponto turístico");

        System.out.print("Nome: ");
        String nome = scn.nextLine();

        System.out.print("Descrição: ");
        String descricao = scn.nextLine();

        System.out.print("Endereço: ");
        String endereco = scn.nextLine();

        System.out.print("Cidade: ");
        String cidade = scn.nextLine();

        System.out.print("Categoria:");
        TipoCategoria categoria = scn.nextLine();
        PontoTuristico p = sist.addPonto(nome, descricao, endereco, cidade, categoria, usuario);

        if (p == null) {
            System.out.println("ERRO! Dados inválidos");

        } else {
            boolean inseriu = sist.addPonto(p, usuario);

            if (inseriu) {
                System.out.println("Ponto cadastrado com sucesso!");
            } else {
                System.out.println("Não foi possível cadastrar o ponto.");
            }
        }

    }

    static void alterarPonto(Sistema sist, Usuario usuario, int codigo) {
        System.out.print("Novo nome: ");
        String nome = scn.nextLine();

        System.out.print("Nova descrição: ");
        String descricao = scn.nextLine();

        System.out.print("Novo endereço: ");
        String endereco = scn.nextLine();

        boolean alterou = sist.alterarPonto(codigo, nome, descricao, endereco, usuario);
        if (alterou) {
            System.out.println("Ponto alterado com sucesso!");
        } else {
            System.out.println("Não foi possível alterar o ponto.");
        }
    }

    static void cadastrarEvento(Sistema sist, Usuario usuario) {
        System.out.println("\n--- CADASTRAR EVENTO ---");

        System.out.print("Nome: ");
        String nome = scn.nextLine();

        System.out.print("Descrição: ");
        String descricao = scn.nextLine();

        System.out.print("Código do ponto turístico: ");
        int codigoPonto = scn.nextInt();
        scn.nextLine();

        System.out.print("Data de início (AAAA-MM-DD): ");
        String dataInicio = scn.nextLine();

        System.out.print("Data de fim (AAAA-MM-DD): ");
        String dataFim = scn.nextLine();

        boolean inseriu = sist.addEvento(nome, descricao, dataInicio, dataFim, codigoPonto, usuario
        );

        if (inseriu) {
            System.out.println("Evento cadastrado com sucesso!");
        } else {
            System.out.println("Não foi possível cadastrar o evento.");
        }
    }

    static void alterarEvento(Sistema sist, Usuario usuario) {

        System.out.print("\nCódigo do evento: ");
        int codigo = scn.nextInt();
        scn.nextLine();

        System.out.print("Novo nome: ");
        String nome = scn.nextLine();

        System.out.print("Nova descrição: ");
        String descricao = scn.nextLine();

        boolean alterou = sist.alterarEvento(codigo, nome, descricao, usuario
        );

        if (alterou) {
            System.out.println("Evento alterado com sucesso!");
        } else {
            System.out.println("Não foi possível alterar o evento.");
        }
    }


    static void printCol(String texto) {
        if (texto.length() > larguraColuna) {
            texto = texto.substring(0, larguraColuna);
        }

        System.out.print(texto);

        int espacosRestantes = larguraColuna - texto.length();

        for (int i = 0; i < espacosRestantes; i++) {
            System.out.print(" ");
        }

        System.out.print(" | ");
    }

    static void listarPontos(Sistema sist) {
        List<PontoTuristico> pontoTuristicos = sist.listarPontos();

        System.out.println();

        printCol("COD");
        printCol("NOME");
        printCol("CIDADE");
        printCol("STATUS");

        System.out.println();

        for (int i = 0; i < pontosTuristicos.size(); i++) {
            PontoTuristico p = pontosTuristicos.get(i);

            printCol(String.valueOf(p.getCodigo())); //transformar int em string
            printCol(p.getNome());
            printCol(String.valueOf(p.getCidade()));
            printCol(String.valueOf(p.getStatus()));

            System.out.println();
        }
    }

    static void listarEventos(Sistema sist) {
        List<Evento> eventos = sist.getEventos();

        System.out.println();

        printCol("COD");
        printCol("NOME");
        printCol("CIDADE");
        printCol("DATAINICIO");
        printCol("DATAFIM");
        System.out.println();

        if (eventos.size() == 0) {
            System.out.println("Nenhum evento encontrado.");
            return;
        }

        for (int i = 0; i < eventos.size(); i++) {
            Evento e = eventos.get(i);

                printCol(String.valueOf(e.getCodigo()));
                printCol(e.getNome());
                printCol(String.valueOf(e.getDataInicio()));
                printCol(String.valueOf(e.getDataFim()));

                System.out.println();

            System.out.println();
        }
    }

    static void listarPontosCidade(Sistema sist) {
        System.out.print("Nome da cidade: ");
        String nomeCidade = scn.nextLine();

        List<PontoTuristico> pontos = sist.listarPontosCidade(nomeCidade);

        System.out.println();

        printCol("COD");
        printCol("NOME");
        printCol("STATUS");
        printCol("ENDERECO");

        System.out.println();

        if (pontos.size() == 0) {
            System.out.println("Nenhum ponto encontrado.");
            return;
        }

        for (int i = 0; i < pontos.size(); i++) {
            PontoTuristico p = pontos.get(i);
                printCol(String.valueOf(p.getCodigo()));
                printCol(p.getNome());
                printCol(String.valueOf(p.getStatus()));
                printCol(String.valueOf(p.getEndereco()));
                System.out.println();
        }
    }

    static void listarEventosCidade(Sistema sist) {
        System.out.print("Nome da cidade: ");
        String nomeCidade = scn.nextLine();

        List<Evento> eventos = sist.listarEventosCidade(nomeCidade);

        System.out.println();

        printCol("COD");
        printCol("NOME");
        printCol("LOCAL");
        System.out.println();

        if (eventos.size() == 0) {
            System.out.println("Nenhum evento encontrado.");
            return;
        }

        for (int i = 0; i < eventos.size(); i++) {
            Evento e = eventos.get(i);

            printCol(String.valueOf(e.getCodigo()));
            printCol(e.getNome());
            printCol(String.valueOf(e.getPontoTuristico()));
            System.out.println();
        }
    }

    static void listarPontosCategoria(Sistema sist) {
        System.out.print("Categoria: ");
        String categoria = scn.nextLine();

        List<PontoTuristico> pontos = sist.listarPontosCategoria(categoria);

        System.out.println();

        printCol("COD");
        printCol("NOME");
        printCol("CIDADE");
        printCol("STATUS");

        System.out.println();

        if (pontos.size() == 0) {
            System.out.println("Nenhum ponto encontrado.");
            return;
        }

        for (int i = 0; i < pontos.size(); i++) {
            PontoTuristico p = pontos.get(i);

            printCol(String.valueOf(p.getCodigo()));
            printCol(p.getNome());
            printCol(String.valueOf(p.getCidade()));
            printCol(String.valueOf(p.getStatus()));
            System.out.println();
        }
    }

    static void aprovarPropriedade(Sistema sist, Usuario usuario) {
        System.out.print("Código do usuário: ");
        int codigoUsuario = scn.nextInt();
        scn.nextLine();

        boolean aprovou = sist.aprovarPropriedade(codigoUsuario, usuario);

        if (aprovou) {
            System.out.println("Solicitação aprovada!");
        } else {
            System.out.println("Não foi possível aprovar a solicitação.");
        }
    }

}
